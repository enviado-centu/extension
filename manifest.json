{
  "manifest_version": 3,
  "name": "Detector de engaños digitales",
  "short_name": "Detector",
  "version": "0.1.0",
  "description": "Te avisa cuando la página que abrís tiene señales de engaño. Solo analiza la dirección.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Detector de engaños digitales",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
